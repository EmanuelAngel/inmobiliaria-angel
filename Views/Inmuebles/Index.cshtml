@model IEnumerable<inmobiliaria_lab2.Models.Inmueble>

@{
    ViewData["Title"] = "Listado de Inmuebles";
    string? estadoFiltro = ViewBag.EstadoFiltro;
    int? idResaltado = ViewBag.Id != null ? Convert.ToInt32(ViewBag.Id) : null;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2>@ViewData["Title"]</h2>
    <div class="d-flex gap-2">
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
            <label for="estado" class="form-label mb-0 text-nowrap fw-semibold">Estado:</label>
            <select id="estado" name="estado" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(estadoFiltro))">Todos</option>
                <option value="Disponible" selected="@(estadoFiltro == "Disponible")">Disponibles</option>
                <option value="Suspendido" selected="@(estadoFiltro == "Suspendido")">Suspendidos</option>
            </select>
        </form>
        <a asp-action="Create" class="btn btn-primary text-nowrap">
            <i class="bi bi-plus-circle"></i> Nuevo Inmueble
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Id)</th>
                        <th>@Html.DisplayNameFor(model => model.Direccion)</th>
                        <th>Tipo</th>
                        <th>Propietario</th>
                        <th class="text-center">@Html.DisplayNameFor(model => model.Cupo)</th>
                        <th class="text-end text-nowrap">@Html.DisplayNameFor(model => model.PrecioPorDia)</th>
                        <th class="text-center">@Html.DisplayNameFor(model => model.PorcentajeSenia)</th>
                        <th class="text-center">@Html.DisplayNameFor(model => model.Estado)</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="@(idResaltado.HasValue && idResaltado.Value == item.Id ? "table-warning fw-semibold" : "")">
                                <td>@item.Id</td>
                                <td>@item.Direccion</td>
                                <td>
                                    <span class="badge bg-secondary">@(item.Tipo?.Descripcion ?? "-")</span>
                                </td>
                                <td>
                                    @(item.Propietario != null ? $"{item.Propietario.NombreCompleto}" : "-")
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-body-tertiary text-body border">@item.Cupo pers.</span>
                                </td>
                                <td class="text-end fw-semibold text-nowrap">
                                    @item.PrecioPorDia.ToString("C")
                                </td>
                                <td class="text-center">
                                    @item.PorcentajeSenia.ToString("N0")%
                                </td>
                                <td class="text-center">
                                    @if (item.Estado == inmobiliaria_lab2.Models.EstadoInmueble.Disponible)
                                    {
                                        <span class="badge bg-success">Disponible</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Suspendido</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <div class="d-inline-flex gap-1 align-items-center">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white" data-bs-toggle="tooltip" data-bs-title="Ver detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning" data-bs-toggle="tooltip" data-bs-title="Editar">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        
                                        @if (item.Estado == inmobiliaria_lab2.Models.EstadoInmueble.Disponible)
                                        {
                                            <a asp-action="CambiarEstado" asp-route-id="@item.Id" asp-route-estado="Suspendido" class="btn btn-sm btn-secondary" data-bs-toggle="tooltip" data-bs-title="Suspender oferta">
                                                <i class="bi bi-pause-circle"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-action="CambiarEstado" asp-route-id="@item.Id" asp-route-estado="Disponible" class="btn btn-sm btn-success" data-bs-toggle="tooltip" data-bs-title="Habilitar oferta">
                                                <i class="bi bi-check-circle"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                No se encontraron inmuebles registrados@(string.IsNullOrEmpty(estadoFiltro) ? "." : $" con estado '{estadoFiltro}'.")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <partial name="_Paginador" model="ViewBag.Paginacion as PaginacionViewModel" />
</div>
