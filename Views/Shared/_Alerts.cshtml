@{
    var mensaje = TempData["Mensaje"] ?? ViewBag.Mensaje;
    var error = TempData["Error"] ?? ViewBag.Error;
    var info = TempData["Info"] ?? ViewBag.Info;
    var warning = TempData["Warning"] ?? ViewBag.Warning;
}

@if (mensaje != null || error != null || warning != null || info != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            if (!window.notyf) return;
            @if (mensaje != null)
            {
                <text>window.notyf.success(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(mensaje.ToString())));</text>
            }
            @if (error != null)
            {
                <text>window.notyf.error(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(error.ToString())));</text>
            }
            @if (warning != null)
            {
                <text>window.notyf.open({ type: 'warning', message: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(warning.ToString())) });</text>
            }
            @if (info != null)
            {
                <text>window.notyf.open({ type: 'info', message: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(info.ToString())) });</text>
            }
        });
    </script>
}
