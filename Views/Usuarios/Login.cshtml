@model inmobiliaria_lab2.Models.LoginUsuarioViewModel

@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5 col-xl-4">
        <div class="card shadow-sm border">
            <div class="card-header bg-primary text-white text-center py-3">
                <div class="mb-2">
                    <i class="bi bi-shield-lock fs-2"></i>
                </div>
                <h4 class="mb-0">Iniciar Sesión</h4>
                <small class="text-white-50">Sistema de Gestión Inmobiliaria</small>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Usuarios" asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" type="email" class="form-control" placeholder="correo@ejemplo.com" autofocus />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                            <button class="btn btn-outline-secondary" type="button" data-password-toggle aria-label="Mostrar contraseña">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary py-2">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Ingresar al Sistema
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
