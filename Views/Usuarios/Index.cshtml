@model IEnumerable<inmobiliaria_lab2.Models.UsuarioListadoViewModel>

@{
    ViewData["Title"] = "Listado de Usuarios";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1">@ViewData["Title"]</h2>
        <p class="text-muted mb-0">Administración de accesos y cuentas del sistema.</p>
    </div>
    <a asp-action="Crear" class="btn btn-primary">
        <i class="bi bi-person-plus-fill me-1"></i> Nuevo Usuario
    </a>
</div>

@{
    var estadoFiltro = (ViewBag.Estado as string)?.ToLower() ?? "activos";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <div class="btn-group btn-group-sm" role="group" aria-label="Filtro de estado">
        <a asp-action="Index" asp-route-estado="activos" class="btn @(estadoFiltro == "activos" ? "btn-primary" : "btn-outline-secondary")">
            Activos
        </a>
        <a asp-action="Index" asp-route-estado="inactivos" class="btn @(estadoFiltro == "inactivos" ? "btn-primary" : "btn-outline-secondary")">
            Inactivos
        </a>
        <a asp-action="Index" asp-route-estado="todos" class="btn @(estadoFiltro == "todos" ? "btn-primary" : "btn-outline-secondary")">
            Todos
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th style="width: 60px;">Foto</th>
                        <th>Nombre Completo</th>
                        <th>Correo Electrónico</th>
                        <th>Rol</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var esUsuarioActual = item.Id.ToString() == currentUserId;
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Avatar))
                                    {
                                        <img src="@item.Avatar" alt="@item.NombreCompleto" class="rounded-circle object-fit-cover border" width="36" height="36" />
                                    }
                                    else
                                    {
                                        <div class="rounded-circle bg-secondary-subtle d-inline-flex align-items-center justify-content-center text-secondary" style="width: 36px; height: 36px;">
                                            <i class="bi bi-person-fill fs-5"></i>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="fw-semibold">@item.NombreCompleto</span>
                                    @if (esUsuarioActual)
                                    {
                                        <span class="badge bg-info-subtle text-info border border-info-subtle ms-1">Tú</span>
                                    }
                                </td>
                                <td>@item.Email</td>
                                <td>
                                    @if (item.Rol == RolUsuario.Administrador)
                                    {
                                        <span class="badge bg-danger">Administrador</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Empleado</span>
                                    }
                                </td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <div class="d-inline-flex gap-1 align-items-center">
                                        @if (item.Activo)
                                        {
                                            <a asp-action="Detalles" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white" data-bs-toggle="tooltip" title="Ver detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-action="Editar" asp-route-id="@item.Id" class="btn btn-sm btn-warning" data-bs-toggle="tooltip" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            @if (esUsuarioActual)
                                            {
                                                <button class="btn btn-sm btn-outline-secondary disabled" title="No puedes eliminar tu propia cuenta" disabled>
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <a asp-action="Eliminar" asp-route-id="@item.Id" class="btn btn-sm btn-danger" data-bs-toggle="tooltip" title="Eliminar">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#modalReactivarUsuario" data-id="@item.Id" data-nombre="@item.NombreCompleto" title="Reactivar usuario">
                                                <i class="bi bi-arrow-counterclockwise"></i> Reactivar
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                No se encontraron usuarios registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <partial name="_Paginador" model="ViewBag.Paginacion as PaginacionViewModel" />
</div>

<!-- Modal de Confirmación de Reactivación Bootstrap -->
<div class="modal fade" id="modalReactivarUsuario" tabindex="-1" aria-labelledby="modalReactivarUsuarioLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalReactivarUsuarioLabel">
                    <i class="bi bi-arrow-counterclockwise text-success me-2"></i>Confirmar reactivación
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">¿Confirma que desea reactivar al usuario <strong id="modalUsuarioNombre"></strong>?</p>
                <small class="text-muted d-block">La cuenta volverá a figurar en los listados activos y el usuario podrá iniciar sesión nuevamente en el sistema.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form asp-action="Activar" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="modalUsuarioId" value="" />
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i>Reactivar usuario
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modalReactivar = document.getElementById('modalReactivarUsuario');
            if (modalReactivar) {
                modalReactivar.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const id = button.getAttribute('data-id');
                    const nombre = button.getAttribute('data-nombre');

                    const inputId = document.getElementById('modalUsuarioId');
                    const spanNombre = document.getElementById('modalUsuarioNombre');

                    if (inputId) {
                        inputId.value = id || '';
                    }
                    if (spanNombre) {
                        spanNombre.textContent = nombre || 'seleccionado';
                    }
                });
            }
        });
    </script>
}
