@model inmobiliaria_lab2.Models.Inmueble

@{
    ViewData["Title"] = $"Galería de Fotos - Inmueble #{Model.Id}";
    var galeria = ViewBag.Galeria as IList<inmobiliaria_lab2.Models.ImagenInmueble> ?? new List<inmobiliaria_lab2.Models.ImagenInmueble>();
}

<div class="row justify-content-center">
    <div class="col-lg-11">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h2 class="mb-1">@ViewData["Title"]</h2>
                <p class="text-muted mb-0">
                    <i class="bi bi-geo-alt"></i> <strong>@Model.Direccion</strong> | 
                    <span class="badge bg-secondary">@(Model.Tipo?.Descripcion ?? "Sin tipo")</span> | 
                    Propietario: <strong>@(Model.Propietario?.NombreCompleto ?? "Sin propietario")</strong>
                </p>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">
                    <i class="bi bi-eye"></i> Ver Detalle
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Volver al Listado
                </a>
            </div>
        </div>

        <!-- Card de Carga de Nuevas Fotos -->
        <div class="card shadow-sm mb-4 border-primary border-opacity-25">
            <div class="card-header bg-primary bg-opacity-10 text-primary fw-semibold d-flex align-items-center gap-2">
                <i class="bi bi-cloud-arrow-up fs-5"></i> Subir nuevas imágenes a la galería
            </div>
            <div class="card-body">
                <form asp-action="SubirImagenes" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="row g-3 align-items-end">
                    <div class="col-md-9">
                        <label for="imagenes" class="form-label fw-semibold">Seleccionar archivos de imagen</label>
                        <input type="file" name="imagenes" id="imagenes" multiple accept=".jpg,.jpeg,.png,.webp,.gif" class="form-control" required />
                        <div class="form-text">
                            Puede seleccionar múltiples archivos manteniendo presionada la tecla Ctrl/Shift. Formatos: JPG, PNG, WEBP, GIF. Máximo 5 MB por archivo.
                        </div>
                    </div>
                    <div class="col-md-3 text-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-upload"></i> Subir a Galería
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Grilla de Fotos de Galería -->
        <div class="card shadow-sm">
            <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="bi bi-images"></i> Fotos en Galería (@galeria.Count)</h5>
            </div>
            <div class="card-body">
                @if (galeria.Any())
                {
                    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-3">
                        @foreach (var img in galeria)
                        {
                            <div class="col">
                                <div class="card h-100 shadow-sm border position-relative overflow-hidden">
                                    <button type="button" 
                                            class="btn btn-danger btn-sm position-absolute top-0 end-0 m-2 rounded-circle p-0 d-flex align-items-center justify-content-center shadow" 
                                            style="width: 32px; height: 32px; z-index: 10;" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#modalEliminarImagen" 
                                            data-id="@img.Id" 
                                            data-url="@img.Url" 
                                            title="Eliminar imagen">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                    <a href="@img.Url" target="_blank" title="Abrir en tamaño completo" class="d-block">
                                        <img src="@img.Url" alt="Foto inmueble #@Model.Id" class="card-img-top object-fit-cover" style="height: 190px;" onerror="this.src='/img/placeholder.png';" />
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-image" style="font-size: 3.5rem;"></i>
                        <h5 class="mt-3">Aún no hay fotos en la galería</h5>
                        <p class="mb-0">Utilice el formulario superior para subir imágenes adicionales de este inmueble.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Modal de Confirmación de Eliminación Bootstrap -->
<div class="modal fade" id="modalEliminarImagen" tabindex="-1" aria-labelledby="modalEliminarImagenLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEliminarImagenLabel">
                    <i class="bi bi-exclamation-triangle text-danger me-2"></i>Confirmar eliminación
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body text-center">
                <p class="mb-3">¿Está seguro de que desea eliminar permanentemente esta imagen de la galería?</p>
                <div class="mb-3">
                    <img id="modalImgPreview" src="" alt="Previsualización" class="rounded object-fit-cover border shadow-sm" style="max-height: 180px; max-width: 100%; display: none;" />
                </div>
                <small class="text-muted d-block">Esta acción eliminará el archivo del servidor y no se puede deshacer.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="formEliminarImagen" asp-action="EliminarImagen" method="post" class="d-inline">
                    <input type="hidden" name="id" id="modalImagenId" value="" />
                    <input type="hidden" name="inmuebleId" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Eliminar permanentemente
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const modalEliminar = document.getElementById('modalEliminarImagen');
            if (modalEliminar) {
                modalEliminar.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    const id = button.getAttribute('data-id');
                    const url = button.getAttribute('data-url');

                    document.getElementById('modalImagenId').value = id;
                    const imgPreview = document.getElementById('modalImgPreview');
                    if (imgPreview && url) {
                        imgPreview.src = url;
                        imgPreview.style.display = 'inline-block';
                    } else if (imgPreview) {
                        imgPreview.style.display = 'none';
                    }
                });
            }
        });
    </script>
}
