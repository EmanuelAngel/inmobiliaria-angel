@model inmobiliaria_lab2.Models.DisponibilidadFiltroViewModel

@{
    ViewData["Title"] = "Disponibilidad de Inmuebles por Fechas";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Informes</a></li>
                <li class="breadcrumb-item active" aria-current="page">Disponibilidad</li>
            </ol>
        </nav>
        <h2 class="mb-0"><i class="bi bi-calendar-check text-primary me-2"></i>@ViewData["Title"]</h2>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver al Hub
        </a>
    </div>
</div>

<!-- Filtro de Búsqueda -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Disponibilidad" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label asp-for="FechaDesde" class="form-label fw-semibold">Fecha Desde</label>
                <input type="date" name="desde" id="desde" class="form-control"
                       value="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))" required />
            </div>
            <div class="col-md-4">
                <label asp-for="FechaHasta" class="form-label fw-semibold">Fecha Hasta</label>
                <input type="date" name="hasta" id="hasta" class="form-control"
                       value="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))" required />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="bi bi-search me-1"></i> Buscar Disponibilidad
                </button>
                @if (Model.BusquedaRealizada)
                {
                    <a asp-action="Disponibilidad" class="btn btn-outline-secondary" title="Limpiar búsqueda">
                        <i class="bi bi-x-circle"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger d-flex align-items-center mb-4 py-2" role="alert">
        <i class="bi bi-exclamation-triangle-fill flex-shrink-0 me-2"></i>
        <div>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    </div>
}

@if (Model.BusquedaRealizada && ViewData.ModelState.IsValid)
{
    if (Model.Inmuebles == null || !Model.Inmuebles.Any())
    {
        <div class="alert alert-warning d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-info-circle-fill flex-shrink-0 me-2 fs-5"></i>
            <div>
                No se encontraron inmuebles disponibles para el período del
                <strong>@(Model.FechaDesde?.ToString("dd/MM/yyyy"))</strong> al
                <strong>@(Model.FechaHasta?.ToString("dd/MM/yyyy"))</strong>.
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-success d-flex align-items-center justify-content-between mb-3 py-2">
            <div>
                <i class="bi bi-check-circle-fill me-2"></i>
                Se encontraron <strong>@Model.Inmuebles.Count</strong> inmueble(s) disponible(s) entre el
                <strong>@(Model.FechaDesde?.ToString("dd/MM/yyyy"))</strong> y el
                <strong>@(Model.FechaHasta?.ToString("dd/MM/yyyy"))</strong>.
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 50px;" class="text-center">Foto</th>
                                <th>Dirección</th>
                                <th>Propietario</th>
                                <th>Tipo</th>
                                <th class="text-center">Capacidad</th>
                                <th class="text-end">Precio por Día</th>
                                <th class="text-end pe-3">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Inmuebles)
                            {
                                <tr>
                                    <td class="text-center p-1">
                                        @if (!string.IsNullOrEmpty(item.ImagenPortada))
                                        {
                                            <img src="@item.ImagenPortada" alt="Foto @item.Direccion" class="rounded object-fit-cover shadow-sm" style="width: 44px; height: 44px;" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'rounded bg-body-secondary d-flex align-items-center justify-content-center mx-auto\' style=\'width:44px;height:44px;\'><i class=\'bi bi-image text-muted\'></i></div>';" />
                                        }
                                        else
                                        {
                                            <div class="rounded bg-body-secondary d-flex align-items-center justify-content-center mx-auto" style="width: 44px; height: 44px;">
                                                <i class="bi bi-image text-muted"></i>
                                            </div>
                                        }
                                    </td>
                                    <td class="fw-semibold">@item.Direccion</td>
                                    <td>@(item.Propietario != null ? item.Propietario.NombreCompleto : "-")</td>
                                    <td>
                                        <span class="badge bg-secondary">@(item.Tipo?.Descripcion ?? "-")</span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-body-tertiary text-body border">@item.Cupo pers.</span>
                                    </td>
                                    <td class="text-end fw-semibold text-nowrap">
                                        @item.PrecioPorDia.ToString("C")
                                    </td>
                                    <td class="text-end pe-3">
                                        <a asp-controller="Reservas"
                                           asp-action="Create"
                                           asp-route-inmuebleId="@item.Id"
                                           asp-route-fechaDesde="@(Model.FechaDesde?.ToString("yyyy-MM-dd"))"
                                           asp-route-fechaHasta="@(Model.FechaHasta?.ToString("yyyy-MM-dd"))"
                                           class="btn btn-sm btn-success">
                                            <i class="bi bi-calendar-plus me-1"></i> Reservar
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}
else if (!Model.BusquedaRealizada)
{
    <div class="text-center py-5 bg-light-subtle rounded-3 border">
        <i class="bi bi-calendar-range text-primary display-4 mb-3"></i>
        <h5 class="fw-semibold">Consulte la disponibilidad de propiedades</h5>
        <p class="text-secondary mb-0">Seleccione una fecha de inicio y finalización para ver las propiedades que no tienen reservas superpuestas.</p>
    </div>
}
