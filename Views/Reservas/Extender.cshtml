@model inmobiliaria_lab2.Models.ReservaExtenderViewModel

@{
    ViewData["Title"] = $"Extender Reserva #{Model.ReservaOriginalId}";
    var reserva = Model.ReservaOriginal;
    var fechaDesdeStr = Model.FechaDesde.ToString("yyyy-MM-dd");
    var fechaHastaMinStr = Model.FechaDesde.AddDays(1).ToString("yyyy-MM-dd");
    var montoPorDiaInvariant = Model.MontoPorDia.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-xl-8">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h2 class="mb-1">@ViewData["Title"]</h2>
                <span class="text-muted">Renovación y prolongación consecutiva de estadía</span>
            </div>
            <a asp-action="Details" asp-route-id="@Model.ReservaOriginalId" class="btn btn-secondary">
                <i class="bi bi-arrow-left me-1"></i> Volver a Detalles
            </a>
        </div>

        @* Advertencia informativa *@
        <div class="alert alert-info d-flex align-items-start gap-3 shadow-sm mb-4" role="alert">
            <i class="bi bi-info-circle-fill fs-3 text-info flex-shrink-0"></i>
            <div>
                <h5 class="alert-heading mb-1">Extensión Consecutiva de Reserva</h5>
                <p class="mb-0 small">
                    Esta operación registrará una nueva reserva activa consecutiva a partir del día de finalización de la reserva original (<strong>@Model.FechaDesde.ToString("dd/MM/yyyy")</strong>).
                    El contrato y pagos de la reserva actual permanecen inalterados.
                </p>
            </div>
        </div>

        @* Resumen de la reserva original *@
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-body-tertiary fw-semibold">
                <i class="bi bi-calendar-check me-1 text-primary"></i> Datos de la Reserva Original #@Model.ReservaOriginalId
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="small text-muted">Inquilino</div>
                        <div class="fw-semibold">@(reserva?.Inquilino?.NombreCompleto ?? "-")</div>
                        <div class="small text-muted">DNI: @(reserva?.Inquilino?.Dni ?? "-")</div>
                        @if (!string.IsNullOrEmpty(reserva?.Inquilino?.Telefono))
                        {
                            <div class="small text-muted">Tel: @reserva.Inquilino.Telefono</div>
                        }
                    </div>
                    <div class="col-md-6">
                        <div class="small text-muted">Inmueble</div>
                        <div class="fw-semibold">@(reserva?.Inmueble?.Direccion ?? "-")</div>
                        <div class="small text-muted">@(reserva?.Inmueble?.Tipo?.Descripcion ?? "") &bull; Cupo: @(reserva?.Inmueble?.Cupo ?? 0) personas</div>
                        @if (reserva?.Inmueble != null)
                        {
                            <div class="small text-muted">Precio de lista: @reserva.Inmueble.PrecioPorDia.ToString("C") / día</div>
                        }
                    </div>
                    <div class="col-md-6">
                        <div class="small text-muted">Período Contratado Original</div>
                        <div class="fw-semibold">
                            @(reserva?.FechaDesde.ToString("dd/MM/yyyy") ?? "-") al @(reserva?.FechaHasta.ToString("dd/MM/yyyy") ?? "-")
                        </div>
                        <div class="small text-muted">Duración original: @(reserva?.DiasTotal ?? 0) días</div>
                    </div>
                    <div class="col-md-6">
                        <div class="small text-muted">Tarifa Diaria Original</div>
                        <div class="fw-semibold">@(reserva?.MontoPorDia.ToString("C") ?? "-") / día</div>
                        <div class="small text-muted">Total contrato anterior: @(reserva?.MontoTotal.ToString("C") ?? "-")</div>
                    </div>
                </div>
            </div>
        </div>

        @* Formulario de extensión *@
        <div class="card shadow-sm mb-4 border-success">
            <div class="card-header bg-success-subtle text-success-emphasis fw-semibold">
                <i class="bi bi-calendar-plus me-1"></i> Parámetros de la Extensión
            </div>
            <div class="card-body p-4">
                <form asp-action="Extender" asp-route-id="@Model.ReservaOriginalId" method="post" id="formExtenderReserva">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReservaOriginalId" />
                    <input type="hidden" asp-for="InmuebleId" />
                    <input type="hidden" asp-for="InquilinoId" />
                    <input type="hidden" asp-for="FechaDesde" />

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="row g-3 mb-4">
                        @* Fecha Desde (bloqueada consecutiva) *@
                        <div class="col-md-6">
                            <label asp-for="FechaDesde" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock-fill text-muted"></i></span>
                                <input type="date"
                                       class="form-control bg-body-tertiary"
                                       value="@fechaDesdeStr"
                                       disabled
                                       readonly />
                            </div>
                            <div class="form-text">
                                Fecha de inicio consecutiva bloqueada al día de salida original (@Model.FechaDesde.ToString("dd/MM/yyyy")).
                            </div>
                        </div>

                        @* Nueva Fecha de Finalización *@
                        <div class="col-md-6">
                            <label asp-for="FechaHasta" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-calendar-event"></i></span>
                                <input asp-for="FechaHasta"
                                       type="date"
                                       class="form-control"
                                       id="inputFechaHasta"
                                       min="@fechaHastaMinStr"
                                       required />
                            </div>
                            <span asp-validation-for="FechaHasta" class="text-danger small"></span>
                            <div class="form-text">
                                Debe ser posterior a la fecha de inicio (@Model.FechaDesde.ToString("dd/MM/yyyy")).
                            </div>
                        </div>

                        @* Monto por Día *@
                        <div class="col-12">
                            <label asp-for="MontoPorDia" class="form-label fw-bold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-currency-dollar"></i></span>
                                <input asp-for="MontoPorDia"
                                       type="number"
                                       step="0.01"
                                       min="0.01"
                                       class="form-control"
                                       id="inputMontoPorDia"
                                       value="@montoPorDiaInvariant"
                                       required />
                            </div>
                            <span asp-validation-for="MontoPorDia" class="text-danger small"></span>
                            <div class="form-text">
                                Tarifa diaria aplicable al período extendido (por defecto la tarifa previa).
                            </div>
                        </div>
                    </div>

                    @* Desglose del cálculo proyectado *@
                    <div class="card bg-body-tertiary border-0 mb-4">
                        <div class="card-body">
                            <h6 class="card-title fw-bold text-uppercase small text-muted mb-3">
                                Resumen Económico Proyectado
                            </h6>
                            <ul class="list-group list-group-flush rounded">
                                <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0 py-2">
                                    <span><i class="bi bi-calendar-range me-2 text-muted"></i> Días de extensión:</span>
                                    <span class="fw-semibold"><span id="lblDiasExtension">@Model.DiasTotal</span> días</span>
                                </li>
                                <li class="list-group-item bg-transparent d-flex justify-content-between align-items-center px-0 py-2">
                                    <span><i class="bi bi-tag me-2 text-muted"></i> Tarifa diaria pactada:</span>
                                    <span class="fw-semibold" id="lblTarifaDiaria">@Model.MontoPorDia.ToString("C")</span>
                                </li>
                            </ul>

                            <hr class="my-3" />

                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <div>
                                    <div class="text-uppercase fw-bold text-success small">Monto Total Estimado de Extensión:</div>
                                    <small class="text-muted">Calculado como: Días × Tarifa diaria</small>
                                </div>
                                <div class="display-6 fw-bold text-success text-end" id="lblMontoTotal">
                                    @Model.MontoTotal.ToString("C")
                                </div>
                            </div>
                        </div>
                    </div>

                    @* Botones de Acción *@
                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Details" asp-route-id="@Model.ReservaOriginalId" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-success btn-lg px-4">
                            <i class="bi bi-check-circle me-1"></i> Confirmar Extensión
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    @* REFACTOR: posible refactor a vue? *@
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const inputFechaHasta = document.getElementById("inputFechaHasta");
            const inputMontoPorDia = document.getElementById("inputMontoPorDia");
            const fechaDesdeStr = "@fechaDesdeStr";

            if (!inputFechaHasta || !inputMontoPorDia || !fechaDesdeStr) return;

            function parseIsoDate(str) {
                const parts = str.split("-");
                if (parts.length !== 3) return null;
                return new Date(Date.UTC(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10)));
            }

            const fechaDesde = parseIsoDate(fechaDesdeStr);
            const msPorDia = 1000 * 60 * 60 * 24;

            const currencyFormatter = new Intl.NumberFormat('es-AR', {
                style: 'currency',
                currency: 'ARS',
                minimumFractionDigits: 2
            });

            function recalcular() {
                const valHasta = inputFechaHasta.value;
                const tarifa = parseFloat(inputMontoPorDia.value) || 0;

                const lblDiasExtension = document.getElementById("lblDiasExtension");
                const lblTarifaDiaria = document.getElementById("lblTarifaDiaria");
                const lblMontoTotal = document.getElementById("lblMontoTotal");

                if (!valHasta) {
                    if (lblDiasExtension) lblDiasExtension.textContent = "0";
                    if (lblTarifaDiaria) lblTarifaDiaria.textContent = currencyFormatter.format(tarifa);
                    if (lblMontoTotal) lblMontoTotal.textContent = currencyFormatter.format(0);
                    return;
                }

                const fechaHasta = parseIsoDate(valHasta);
                let dias = 0;
                if (fechaHasta && fechaDesde && fechaHasta > fechaDesde) {
                    dias = Math.round((fechaHasta - fechaDesde) / msPorDia);
                }

                const total = dias * tarifa;

                if (lblDiasExtension) lblDiasExtension.textContent = dias;
                if (lblTarifaDiaria) lblTarifaDiaria.textContent = currencyFormatter.format(tarifa);
                if (lblMontoTotal) lblMontoTotal.textContent = currencyFormatter.format(total);
            }

            inputFechaHasta.addEventListener("change", recalcular);
            inputFechaHasta.addEventListener("input", recalcular);
            inputMontoPorDia.addEventListener("change", recalcular);
            inputMontoPorDia.addEventListener("input", recalcular);

            recalcular();
        });
    </script>
}
