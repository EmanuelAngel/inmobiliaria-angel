@model inmobiliaria_lab2.Models.PerfilUsuarioViewModel

@{
    ViewData["Title"] = "Mi Perfil";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="d-flex align-items-center mb-4">
            <h2 class="mb-0">
                <i class="bi bi-person-gear me-2"></i>@ViewData["Title"]
            </h2>
        </div>

        <form asp-action="Perfil" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4" role="alert"></div>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="AvatarActual" />
            <input type="hidden" asp-for="Rol" />

            <div class="row g-4">
                <!-- Columna Izquierda: Avatar y Datos de Cuenta -->
                <div class="col-lg-4">
                    <div class="card shadow-sm text-center p-4">
                        <div class="mb-3">
                            @if (!string.IsNullOrEmpty(Model.AvatarActual))
                            {
                                <img src="@Model.AvatarActual" alt="Avatar de usuario" class="rounded-circle object-fit-cover border shadow-sm" width="120" height="120" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-secondary-subtle d-inline-flex align-items-center justify-content-center text-secondary shadow-sm" style="width: 120px; height: 120px;">
                                    <i class="bi bi-person-fill display-3"></i>
                                </div>
                            }
                        </div>

                        <h4 class="mb-1">@Model.Nombre @Model.Apellido</h4>
                        <div class="text-muted small mb-2">@Model.Email</div>

                        <div class="mb-3">
                            @if (Model.Rol == RolUsuario.Administrador)
                            {
                                <span class="badge bg-danger fs-6">Administrador</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6">Empleado</span>
                            }
                        </div>

                        <div class="border-top pt-3 text-start">
                            <label asp-for="AvatarFile" class="form-label fw-semibold small mb-1">Cambiar foto de perfil</label>
                            <input asp-for="AvatarFile" type="file" accept=".jpg,.jpeg,.png,.webp,.gif" class="form-control form-control-sm mb-2" />
                            <span asp-validation-for="AvatarFile" class="text-danger small"></span>

                            @if (!string.IsNullOrEmpty(Model.AvatarActual))
                            {
                                <div class="form-check mt-2">
                                    <input asp-for="QuitarAvatar" class="form-check-input" type="checkbox" id="checkQuitarAvatar" />
                                    <label asp-for="QuitarAvatar" class="form-check-label text-danger small">
                                        Quitar foto de perfil
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Columna Derecha: Datos Personales y Seguridad -->
                <div class="col-lg-8">
                    <!-- Datos Personales -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-body-tertiary">
                            <h5 class="mb-0">
                                <i class="bi bi-card-text me-2"></i>Datos Personales
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label asp-for="Nombre" class="form-label fw-semibold"></label>
                                    <input asp-for="Nombre" class="form-control" />
                                    <span asp-validation-for="Nombre" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="Apellido" class="form-label fw-semibold"></label>
                                    <input asp-for="Apellido" class="form-control" />
                                    <span asp-validation-for="Apellido" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="mb-0">
                                <label asp-for="Email" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                    <input asp-for="Email" type="email" class="form-control" />
                                </div>
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Seguridad / Cambio de Contraseña -->
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-body-tertiary">
                            <h5 class="mb-0">
                                <i class="bi bi-shield-lock me-2"></i>Seguridad y Contraseña
                            </h5>
                        </div>
                        <div class="card-body p-4">
                            <p class="text-muted small mb-3">
                                Complete los siguientes campos únicamente si desea modificar su contraseña. Si desea mantener su contraseña actual, deje estos campos vacíos.
                            </p>

                            <div class="mb-3">
                                <label asp-for="ClaveActual" class="form-label fw-semibold"></label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                    <input asp-for="ClaveActual" type="password" class="form-control" placeholder="Ingrese su contraseña actual para confirmar" autocomplete="current-password" />
                                    <button class="btn btn-outline-secondary" type="button" data-password-toggle aria-label="Mostrar contraseña">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ClaveActual" class="text-danger small"></span>
                            </div>

                            <div class="row mb-0">
                                <div class="col-md-6 mb-3 mb-md-0">
                                    <label asp-for="NuevaClave" class="form-label fw-semibold"></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-key"></i></span>
                                        <input asp-for="NuevaClave" type="password" class="form-control" placeholder="Mínimo 8 caracteres" autocomplete="new-password" />
                                        <button class="btn btn-outline-secondary" type="button" data-password-toggle aria-label="Mostrar contraseña">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="NuevaClave" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="ConfirmarClave" class="form-label fw-semibold"></label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                                        <input asp-for="ConfirmarClave" type="password" class="form-control" placeholder="Repita la nueva contraseña" autocomplete="new-password" />
                                        <button class="btn btn-outline-secondary" type="button" data-password-toggle aria-label="Mostrar contraseña">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                    <span asp-validation-for="ConfirmarClave" class="text-danger small"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary px-4 py-2">
                            <i class="bi bi-check-circle me-1"></i> Guardar Cambios
                        </button>
                    </div>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
