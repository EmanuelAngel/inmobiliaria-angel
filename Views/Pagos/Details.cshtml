@model inmobiliaria_lab2.Models.Pago

@{
    ViewData["Title"] = $"Detalle del Pago #{Model.Id}";
    var usuarioCreacion = ViewBag.UsuarioCreacion as inmobiliaria_lab2.Models.Usuario;
    var usuarioAnulacion = ViewBag.UsuarioAnulacion as inmobiliaria_lab2.Models.Usuario;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="mb-0">@ViewData["Title"]</h2>
            <div>
                @if (Model.Estado == inmobiliaria_lab2.Models.EstadoPago.Activo)
                {
                    <span class="badge bg-success fs-6">Activo</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6">Anulado</span>
                }
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-body-tertiary fw-semibold">
                <i class="bi bi-cash-stack me-2"></i> Información de la Transacción
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Código de Pago:</dt>
                    <dd class="col-sm-8 fw-semibold">#@Model.Id</dd>

                    <dt class="col-sm-4 text-muted">Reserva Asociada:</dt>
                    <dd class="col-sm-8">
                        <a asp-controller="Reservas" asp-action="Details" asp-route-id="@Model.ReservaId" class="text-decoration-none">
                            <i class="bi bi-link-45deg"></i> Reserva #@Model.ReservaId
                        </a>
                    </dd>

                    @if (Model.Reserva != null)
                    {
                        <dt class="col-sm-4 text-muted">Inquilino:</dt>
                        <dd class="col-sm-8">@(Model.Reserva.Inquilino?.NombreCompleto ?? "-") (DNI: @(Model.Reserva.Inquilino?.Dni ?? "-"))</dd>

                        <dt class="col-sm-4 text-muted">Inmueble:</dt>
                        <dd class="col-sm-8">@(Model.Reserva.Inmueble?.Direccion ?? "-")</dd>
                    }

                    <dt class="col-sm-4 text-muted">Fecha de Pago:</dt>
                    <dd class="col-sm-8">@Model.Fecha.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-4 text-muted">Importe Abonado:</dt>
                    <dd class="col-sm-8 fs-5 fw-bold @(Model.Estado == inmobiliaria_lab2.Models.EstadoPago.Anulado ? "text-muted text-decoration-line-through" : "text-success")">
                        @Model.Importe.ToString("C")
                    </dd>

                    <dt class="col-sm-4 text-muted">Concepto:</dt>
                    <dd class="col-sm-8">@Model.Concepto</dd>
                </dl>
            </div>
        </div>

        @if (User.IsInRole("Administrador"))
        {
            <div class="card shadow-sm border-info-subtle mb-4">
                <div class="card-header bg-info-subtle text-info-emphasis fw-semibold">
                    <i class="bi bi-shield-lock me-2"></i> Auditoría de Seguridad (Solo Administradores)
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Registrado por:</dt>
                        <dd class="col-sm-8">
                            @if (usuarioCreacion != null)
                            {
                                <span class="fw-semibold">@usuarioCreacion.NombreCompleto</span>
                                <span class="text-muted small">(@usuarioCreacion.Email - @usuarioCreacion.Rol)</span>
                            }
                            else if (Model.UsuarioCreacion != null)
                            {
                                <span class="fw-semibold">@Model.UsuarioCreacion.NombreCompleto</span>
                                <span class="text-muted small">(@Model.UsuarioCreacion.Email)</span>
                            }
                            else
                            {
                                <span class="text-muted">Usuario #@Model.UsuarioCreacionId</span>
                            }
                        </dd>

                        @if (Model.Estado == inmobiliaria_lab2.Models.EstadoPago.Anulado)
                        {
                            <dt class="col-sm-4 text-muted text-danger">Anulado por:</dt>
                            <dd class="col-sm-8 text-danger">
                                @if (usuarioAnulacion != null)
                                {
                                    <span class="fw-semibold">@usuarioAnulacion.NombreCompleto</span>
                                    <span class="small">(@usuarioAnulacion.Email - @usuarioAnulacion.Rol)</span>
                                }
                                else if (Model.UsuarioAnulacion != null)
                                {
                                    <span class="fw-semibold">@Model.UsuarioAnulacion.NombreCompleto</span>
                                    <span class="small">(@Model.UsuarioAnulacion.Email)</span>
                                }
                                else if (Model.UsuarioAnulacionId.HasValue)
                                {
                                    <span>Usuario #@Model.UsuarioAnulacionId.Value</span>
                                }
                                else
                                {
                                    <span>No especificado</span>
                                }
                            </dd>
                        }
                    </dl>
                </div>
            </div>
        }

        <div class="d-flex justify-content-between align-items-center">
            <div class="d-flex gap-2">
                <a asp-action="Index" asp-route-reservaId="@Model.ReservaId" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Pagos de la Reserva
                </a>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    Listado General
                </a>
            </div>
            <div class="d-flex gap-2">
                @if (Model.Estado == inmobiliaria_lab2.Models.EstadoPago.Activo)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="bi bi-pencil"></i> Editar Concepto
                    </a>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                            <i class="bi bi-slash-circle"></i> Anular Pago
                        </a>
                    }
                }
            </div>
        </div>
    </div>
</div>
