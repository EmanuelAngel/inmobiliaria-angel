@model inmobiliaria_lab2.Models.UsuarioDetalleViewModel

@{
    ViewData["Title"] = "Detalle del Usuario";
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var esUsuarioActual = Model.Id.ToString() == currentUserId;
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="bi bi-person-lines-fill me-2"></i>@ViewData["Title"]
                </h4>
                @if (Model.Activo)
                {
                    <span class="badge bg-success">Activo</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactivo</span>
                }
            </div>
            <div class="card-body p-4 text-center">
                <div class="mb-4">
                    @if (!string.IsNullOrEmpty(Model.Avatar))
                    {
                        <img src="@Model.Avatar" alt="@Model.NombreCompleto" class="rounded-circle object-fit-cover border shadow-sm" width="100" height="100" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-secondary-subtle d-inline-flex align-items-center justify-content-center text-secondary shadow-sm" style="width: 100px; height: 100px;">
                            <i class="bi bi-person-fill display-4"></i>
                        </div>
                    }
                    <h3 class="mt-3 mb-1">@Model.NombreCompleto</h3>
                    <div>
                        @if (Model.Rol == RolUsuario.Administrador)
                        {
                            <span class="badge bg-danger fs-6">Administrador</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary fs-6">Empleado</span>
                        }
                    </div>
                </div>

                <div class="text-start border-top pt-3">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">ID Usuario:</dt>
                        <dd class="col-sm-8 fw-semibold">#@Model.Id</dd>

                        <dt class="col-sm-4 text-muted">Nombre:</dt>
                        <dd class="col-sm-8">@Model.Nombre</dd>

                        <dt class="col-sm-4 text-muted">Apellido:</dt>
                        <dd class="col-sm-8">@Model.Apellido</dd>

                        <dt class="col-sm-4 text-muted">Email:</dt>
                        <dd class="col-sm-8">
                            <a href="mailto:@Model.Email" class="text-decoration-none">@Model.Email</a>
                        </dd>

                        <dt class="col-sm-4 text-muted">Estado:</dt>
                        <dd class="col-sm-8">
                            @(Model.Activo ? "Habilitado para ingresar al sistema" : "Deshabilitado")
                        </dd>
                    </dl>
                </div>
            </div>
            <div class="card-footer d-flex justify-content-between p-3">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Volver al listado
                </a>
                <div class="d-flex gap-2">
                    <a asp-action="Editar" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="bi bi-pencil me-1"></i> Editar
                    </a>
                    @if (!esUsuarioActual)
                    {
                        <a asp-action="Eliminar" asp-route-id="@Model.Id" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i> Eliminar
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
