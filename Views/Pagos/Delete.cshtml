@model inmobiliaria_lab2.Models.Pago

@{
    ViewData["Title"] = $"Anular Pago #{Model.Id}";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <h2 class="text-danger mb-3">
            <i class="bi bi-slash-circle me-2"></i> @ViewData["Title"]
        </h2>

        <div class="alert alert-warning border-warning d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-3 text-warning me-3"></i>
            <div>
                <strong>Atención:</strong> La anulación es una baja lógica contable irreversible. El pago se mantendrá en el historial pero su importe <strong>dejará de computar en el saldo abonado</strong> de la reserva, registrando su usuario como auditor responsable de la anulación.
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-body-tertiary fw-semibold">
                Detalle del Pago a Anular
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted">Código:</dt>
                    <dd class="col-sm-8 fw-bold">#@Model.Id</dd>

                    <dt class="col-sm-4 text-muted">Reserva:</dt>
                    <dd class="col-sm-8">#@Model.ReservaId (@(Model.Reserva?.Inmueble?.Direccion ?? "-"))</dd>

                    <dt class="col-sm-4 text-muted">Inquilino:</dt>
                    <dd class="col-sm-8">@(Model.Reserva?.Inquilino?.NombreCompleto ?? "-")</dd>

                    <dt class="col-sm-4 text-muted">Fecha:</dt>
                    <dd class="col-sm-8">@Model.Fecha.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-4 text-muted">Importe:</dt>
                    <dd class="col-sm-8 fs-5 fw-bold text-danger">@Model.Importe.ToString("C")</dd>

                    <dt class="col-sm-4 text-muted">Concepto:</dt>
                    <dd class="col-sm-8">@Model.Concepto</dd>
                </dl>
            </div>
        </div>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-between">
                <a asp-action="Index" asp-route-reservaId="@Model.ReservaId" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-danger px-4">
                    <i class="bi bi-trash"></i> Confirmar Anulación
                </button>
            </div>
        </form>
    </div>
</div>
