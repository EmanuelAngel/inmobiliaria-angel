@model IEnumerable<inmobiliaria_lab2.Models.Inmueble>

@{
    ViewData["Title"] = "Listado de Inmuebles";
    int paginaActual = ViewBag.Pagina != null ? (int)ViewBag.Pagina : 1;
    int totalPaginas = ViewBag.TotalPaginas != null ? (int)ViewBag.TotalPaginas : 1;
    int tamDePagina = ViewBag.TamDePagina != null ? (int)ViewBag.TamDePagina : 10;
    string? estadoFiltro = ViewBag.EstadoFiltro;
    int? idResaltado = ViewBag.Id != null ? Convert.ToInt32(ViewBag.Id) : null;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2>@ViewData["Title"]</h2>
    <div class="d-flex gap-2">
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
            <label for="estado" class="form-label mb-0 text-nowrap fw-semibold">Estado:</label>
            <select id="estado" name="estado" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(estadoFiltro))">Todos</option>
                <option value="Disponible" selected="@(estadoFiltro == "Disponible")">Disponibles</option>
                <option value="Suspendido" selected="@(estadoFiltro == "Suspendido")">Suspendidos</option>
            </select>
        </form>
        <a asp-action="Create" class="btn btn-primary text-nowrap">
            <i class="bi bi-plus-circle"></i> Nuevo Inmueble
        </a>
    </div>
</div>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Mensaje"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Id)</th>
                        <th>@Html.DisplayNameFor(model => model.Direccion)</th>
                        <th>Tipo</th>
                        <th>Propietario</th>
                        <th class="text-center">@Html.DisplayNameFor(model => model.Cupo)</th>
                        <th class="text-end">@Html.DisplayNameFor(model => model.PrecioPorDia)</th>
                        <th class="text-center">@Html.DisplayNameFor(model => model.PorcentajeSenia)</th>
                        <th class="text-center">@Html.DisplayNameFor(model => model.Estado)</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="@(idResaltado.HasValue && idResaltado.Value == item.Id ? "table-warning fw-semibold" : "")">
                                <td>@item.Id</td>
                                <td>@item.Direccion</td>
                                <td>
                                    <span class="badge bg-secondary">@(item.Tipo?.Descripcion ?? "-")</span>
                                </td>
                                <td>
                                    @(item.Propietario != null ? $"{item.Propietario.NombreCompleto}" : "-")
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@item.Cupo pers.</span>
                                </td>
                                <td class="text-end fw-semibold">
                                    @item.PrecioPorDia.ToString("C")
                                </td>
                                <td class="text-center">
                                    @item.PorcentajeSenia.ToString("N0")%
                                </td>
                                <td class="text-center">
                                    @if (item.Estado == inmobiliaria_lab2.Models.EstadoInmueble.Disponible)
                                    {
                                        <span class="badge bg-success">Disponible</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Suspendido</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info" title="Detalles">Detalles</a>
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning" title="Editar">Editar</a>
                                        
                                        @if (item.Estado == inmobiliaria_lab2.Models.EstadoInmueble.Disponible)
                                        {
                                            <form asp-action="CambiarEstado" method="post" class="d-inline" onsubmit="return confirm('¿Desea suspender la oferta de este inmueble?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="estado" value="Suspendido" />
                                                <button type="submit" class="btn btn-outline-secondary" title="Suspender oferta">Suspender</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="CambiarEstado" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <input type="hidden" name="estado" value="Disponible" />
                                                <button type="submit" class="btn btn-outline-success" title="Habilitar oferta">Habilitar</button>
                                            </form>
                                        }

                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger" title="Dar de baja">Baja</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                No se encontraron inmuebles registrados@(string.IsNullOrEmpty(estadoFiltro) ? "." : $" con estado '{estadoFiltro}'.")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (totalPaginas > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <small class="text-muted">Página @paginaActual de @totalPaginas (@(ViewBag.TotalRegistros ?? 0) registros en total)</small>
            <nav aria-label="Navegación de páginas">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)" asp-route-tamDePagina="@tamDePagina" asp-route-estado="@estadoFiltro">Anterior</a>
                    </li>
                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        <li class="page-item @(i == paginaActual ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-tamDePagina="@tamDePagina" asp-route-estado="@estadoFiltro">@i</a>
                        </li>
                    }
                    <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)" asp-route-tamDePagina="@tamDePagina" asp-route-estado="@estadoFiltro">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
