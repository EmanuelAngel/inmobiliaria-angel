@model inmobiliaria_lab2.Models.PagosIndexViewModel

@{
    ViewData["Title"] = Model.ReservaContexto != null
        ? $"Pagos de la Reserva #{Model.ReservaContexto.Id}"
        : "Listado General de Pagos";
    int? idResaltado = ViewBag.Id != null ? Convert.ToInt32(ViewBag.Id) : null;
}

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @ViewBag.Mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @ViewBag.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="mb-1">@ViewData["Title"]</h2>
        @if (Model.ReservaContexto != null)
        {
            <p class="text-muted mb-0">
                Inmueble: <strong>@Model.ReservaContexto.Inmueble?.Direccion</strong> &bull;
                Inquilino: <strong>@Model.ReservaContexto.Inquilino?.NombreCompleto</strong> &bull;
                Período: @Model.ReservaContexto.FechaDesde.ToString("dd/MM/yyyy") al @Model.ReservaContexto.FechaHasta.ToString("dd/MM/yyyy")
            </p>
        }
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
            @if (Model.ReservaIdFiltro.HasValue)
            {
                <input type="hidden" name="reservaId" value="@Model.ReservaIdFiltro.Value" />
            }
            <label for="estado" class="form-label mb-0 text-nowrap fw-semibold">Estado:</label>
            <select id="estado" name="estado" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(Model.EstadoFiltro))">Todos</option>
                <option value="Activo" selected="@(Model.EstadoFiltro == "Activo")">Activos</option>
                <option value="Anulado" selected="@(Model.EstadoFiltro == "Anulado")">Anulados</option>
            </select>
        </form>
        @if (Model.ReservaContexto != null)
        {
            @if (Model.SaldoPendiente > 0 && Model.ReservaContexto.Estado == inmobiliaria_lab2.Models.EstadoReserva.Activa)
            {
                <a asp-action="Create" asp-route-reservaId="@Model.ReservaContexto.Id" class="btn btn-primary text-nowrap">
                    <i class="bi bi-plus-circle"></i> Cargar Pago
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary text-nowrap">
                <i class="bi bi-list-ul"></i> Ver Todos los Pagos
            </a>
        }
        else
        {
            <a asp-action="Create" class="btn btn-primary text-nowrap">
                <i class="bi bi-plus-circle"></i> Nuevo Pago
            </a>
        }
    </div>
</div>

@if (Model.ReservaContexto != null)
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-primary-subtle text-primary-emphasis">
                <div class="card-body p-3">
                    <div class="text-uppercase small fw-semibold text-muted">Total del Contrato</div>
                    <div class="fs-4 fw-bold">@Model.TotalReserva.ToString("C")</div>
                    <small class="text-muted">(@Model.ReservaContexto.DiasTotal días &times; @Model.ReservaContexto.MontoPorDia.ToString("C"))</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm bg-success-subtle text-success-emphasis">
                <div class="card-body p-3">
                    <div class="text-uppercase small fw-semibold text-muted">Total Abonado (Activo)</div>
                    <div class="fs-4 fw-bold">@Model.TotalPagado.ToString("C")</div>
                    <small class="text-muted">Suma de pagos no anulados</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm @(Model.SaldoPendiente > 0 ? "bg-warning-subtle text-warning-emphasis" : "bg-light text-muted")">
                <div class="card-body p-3">
                    <div class="text-uppercase small fw-semibold text-muted">Saldo Pendiente</div>
                    <div class="fs-4 fw-bold">@Model.SaldoPendiente.ToString("C")</div>
                    <small class="text-muted">@(Model.SaldoPendiente > 0 ? "Importe restante por saldar" : "Contrato cancelado / al día")</small>
                </div>
            </div>
        </div>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th class="ps-3">Código</th>
                        @if (Model.ReservaContexto == null)
                        {
                            <th>Reserva</th>
                            <th>Inquilino</th>
                        }
                        <th>Fecha</th>
                        <th>Concepto</th>
                        <th class="text-end">Importe</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end pe-3">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Pagos != null && Model.Pagos.Any())
                    {
                        foreach (var item in Model.Pagos)
                        {
                            var esAnulado = item.Estado == inmobiliaria_lab2.Models.EstadoPago.Anulado;
                            <tr class="@(idResaltado.HasValue && idResaltado.Value == item.Id ? "table-warning fw-semibold" : "") @(esAnulado ? "opacity-75" : "")">
                                <td class="ps-3 fw-semibold">#@item.Id</td>
                                @if (Model.ReservaContexto == null)
                                {
                                    <td>
                                        <a asp-controller="Reservas" asp-action="Details" asp-route-id="@item.ReservaId" class="text-decoration-none">
                                            #@item.ReservaId (@(item.Reserva?.Inmueble?.Direccion ?? "Inmueble"))
                                        </a>
                                    </td>
                                    <td>@(item.Reserva?.Inquilino?.NombreCompleto ?? "-")</td>
                                }
                                <td class="text-nowrap">@item.Fecha.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="@(esAnulado ? "text-decoration-line-through text-muted" : "")">@item.Concepto</span>
                                </td>
                                <td class="text-end fw-semibold text-nowrap @(esAnulado ? "text-muted text-decoration-line-through" : "text-success")">
                                    @item.Importe.ToString("C")
                                </td>
                                <td class="text-center">
                                    @if (item.Estado == inmobiliaria_lab2.Models.EstadoPago.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Anulado</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap pe-3">
                                    <div class="d-inline-flex gap-1 align-items-center">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-info text-white"
                                           data-bs-toggle="tooltip" data-bs-title="Ver detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (item.Estado == inmobiliaria_lab2.Models.EstadoPago.Activo)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-warning text-dark"
                                               data-bs-toggle="tooltip" data-bs-title="Editar concepto">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            @if (User.IsInRole("Administrador"))
                                            {
                                                <a asp-action="Delete" asp-route-id="@item.Id"
                                                   class="btn btn-sm btn-danger"
                                                   data-bs-toggle="tooltip" data-bs-title="Anular pago">
                                                    <i class="bi bi-slash-circle"></i>
                                                </a>
                                            }
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@(Model.ReservaContexto == null ? 7 : 5)" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                No se encontraron pagos registrados con los criterios seleccionados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="mt-3">
    <partial name="_Paginador" model="Model.Paginacion" />
</div>
