@model inmobiliaria_lab2.Models.UsuarioDetalleViewModel

@{
    ViewData["Title"] = "Eliminar Usuario";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card border-danger shadow-sm">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewData["Title"]
                </h4>
            </div>
            <div class="card-body p-4">
                <div class="alert alert-warning mb-4" role="alert">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-shield-exclamation fs-3 me-2 text-warning"></i>
                        <div>
                            <strong>¿Está seguro de que desea eliminar este usuario?</strong>
                            <div class="small text-muted">El usuario será dado de baja en el sistema y perderá el acceso inmediatamente.</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-3 p-3 bg-body-tertiary border mb-4">
                    @if (!string.IsNullOrEmpty(Model.Avatar))
                    {
                        <img src="@Model.Avatar" alt="@Model.NombreCompleto" class="rounded-circle object-fit-cover border" width="60" height="60" />
                    }
                    else
                    {
                        <div class="rounded-circle bg-secondary-subtle d-inline-flex align-items-center justify-content-center text-secondary" style="width: 60px; height: 60px;">
                            <i class="bi bi-person-fill fs-3"></i>
                        </div>
                    }
                    <div>
                        <h5 class="mb-1">@Model.NombreCompleto</h5>
                        <div class="text-muted small">@Model.Email</div>
                        <div class="mt-1">
                            @if (Model.Rol == RolUsuario.Administrador)
                            {
                                <span class="badge bg-danger">Administrador</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Empleado</span>
                            }
                        </div>
                    </div>
                </div>

                <form asp-action="Eliminar" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-between pt-2">
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Cancelar
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash me-1"></i> Confirmar Eliminación
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
