@model inmobiliaria_lab2.Models.MonitoreoReservasViewModel

@{
    ViewData["Title"] = "Monitoreo de Reservas";
    var hoy = DateOnly.FromDateTime(DateTime.Today);
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Informes</a></li>
                <li class="breadcrumb-item active" aria-current="page">Monitoreo de Reservas</li>
            </ol>
        </nav>
        <h2 class="mb-0"><i class="bi bi-clock-history text-info me-2"></i>@ViewData["Title"]</h2>
        <p class="text-secondary mb-0">Control en tiempo real de reservas vigentes y seguimiento de contratos próximos a finalizar.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver al Hub
        </a>
    </div>
</div>

<!-- Navegación por pestañas (Nav-tabs) -->
<ul class="nav nav-tabs mb-4" id="monitoreoTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <a class="nav-link @(Model.TabActiva == "vigentes" ? "active fw-semibold" : "")"
           asp-action="MonitoreoReservas"
           asp-route-tab="vigentes"
           asp-route-dias="@Model.DiasVencimiento">
            <i class="bi bi-calendar-check me-2"></i>Reservas Vigentes
            <span class="badge bg-primary rounded-pill ms-2">@Model.ReservasVigentes.Count</span>
        </a>
    </li>
    <li class="nav-item" role="presentation">
        <a class="nav-link @(Model.TabActiva == "por-vencer" ? "active fw-semibold" : "")"
           asp-action="MonitoreoReservas"
           asp-route-tab="por-vencer"
           asp-route-dias="@Model.DiasVencimiento">
            <i class="bi bi-hourglass-split me-2"></i>Próximas a Vencer
            <span class="badge bg-warning text-dark rounded-pill ms-2">@Model.ReservasPorVencer.Count</span>
        </a>
    </li>
</ul>

@if (Model.TabActiva == "por-vencer")
{
    <!-- Selector y filtros de días para vencimientos -->
    <div class="card shadow-sm mb-4 border-0 bg-body-tertiary">
        <div class="card-body py-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="fw-semibold text-secondary me-1">
                        <i class="bi bi-funnel me-1"></i> Ventana de vencimiento:
                    </span>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Filtro rápido de días">
                        <a asp-action="MonitoreoReservas" asp-route-tab="por-vencer" asp-route-dias="7"
                           class="btn @(Model.DiasVencimiento == 7 ? "btn-primary" : "btn-outline-primary")">
                            7 días
                        </a>
                        <a asp-action="MonitoreoReservas" asp-route-tab="por-vencer" asp-route-dias="15"
                           class="btn @(Model.DiasVencimiento == 15 ? "btn-primary" : "btn-outline-primary")">
                            15 días
                        </a>
                        <a asp-action="MonitoreoReservas" asp-route-tab="por-vencer" asp-route-dias="30"
                           class="btn @(Model.DiasVencimiento == 30 ? "btn-primary" : "btn-outline-primary")">
                            30 días
                        </a>
                        <a asp-action="MonitoreoReservas" asp-route-tab="por-vencer" asp-route-dias="60"
                           class="btn @(Model.DiasVencimiento == 60 ? "btn-primary" : "btn-outline-primary")">
                            60 días
                        </a>
                    </div>
                </div>

                <form method="get" asp-action="MonitoreoReservas" class="d-flex align-items-center gap-2">
                    <input type="hidden" name="tab" value="por-vencer" />
                    <div class="input-group input-group-sm" style="width: 170px;">
                        <input type="number" name="dias" min="1" max="365" class="form-control"
                               value="@Model.DiasVencimiento" placeholder="Días" required />
                        <span class="input-group-text">días</span>
                        <button type="submit" class="btn btn-outline-secondary" title="Aplicar filtro personalizado">
                            <i class="bi bi-arrow-right-short"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (!Model.ReservasPorVencer.Any())
    {
        <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-info-circle-fill flex-shrink-0 me-2 fs-5"></i>
            <div>
                No se registran reservas que finalicen dentro de los próximos <strong>@Model.DiasVencimiento</strong> días.
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-warning-subtle border border-warning-subtle text-dark d-flex align-items-center mb-3 py-2">
            <i class="bi bi-exclamation-circle-fill text-warning me-2 fs-5"></i>
            <div>
                Se registran <strong>@Model.ReservasPorVencer.Count</strong> reserva(s) con finalización programada dentro de los próximos <strong>@Model.DiasVencimiento</strong> días.
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60px;"># ID</th>
                                <th>Inmueble</th>
                                <th>Inquilino</th>
                                <th class="text-nowrap">Desde</th>
                                <th class="text-nowrap">Hasta</th>
                                <th class="text-center">Días Restantes</th>
                                <th class="text-end">Monto Total</th>
                                <th class="text-end pe-3">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ReservasPorVencer)
                            {
                                var fechaFin = item.FechaFinAnticipado ?? item.FechaHasta;
                                var diasRestantes = fechaFin.DayNumber - hoy.DayNumber;
                                string badgeClass;
                                string textoRestante;

                                if (diasRestantes <= 0)
                                {
                                    badgeClass = "bg-danger text-white";
                                    textoRestante = "Finaliza hoy";
                                }
                                else if (diasRestantes == 1)
                                {
                                    badgeClass = "bg-danger text-white";
                                    textoRestante = "1 día";
                                }
                                else if (diasRestantes <= 3)
                                {
                                    badgeClass = "bg-danger text-white";
                                    textoRestante = $"{diasRestantes} días";
                                }
                                else if (diasRestantes <= 7)
                                {
                                    badgeClass = "bg-warning text-dark";
                                    textoRestante = $"{diasRestantes} días";
                                }
                                else if (diasRestantes <= 15)
                                {
                                    badgeClass = "bg-info text-dark";
                                    textoRestante = $"{diasRestantes} días";
                                }
                                else
                                {
                                    badgeClass = "bg-secondary-subtle text-secondary border";
                                    textoRestante = $"{diasRestantes} días";
                                }

                                <tr>
                                    <td class="fw-semibold">@item.Id</td>
                                    <td>
                                        <div class="fw-semibold">@(item.Inmueble?.Direccion ?? "-")</div>
                                        <div class="small text-muted">
                                            <span class="badge bg-secondary-subtle text-secondary border">@(item.Inmueble?.Tipo?.Descripcion ?? "-")</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div>@(item.Inquilino?.NombreCompleto ?? "-")</div>
                                        <div class="small text-muted">DNI: @(item.Inquilino?.Dni ?? "-")</div>
                                    </td>
                                    <td class="text-nowrap">@item.FechaDesde.ToString("dd/MM/yyyy")</td>
                                    <td class="text-nowrap">@fechaFin.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        <span class="badge @badgeClass">@textoRestante</span>
                                    </td>
                                    <td class="text-end fw-semibold text-nowrap">@item.MontoTotal.ToString("C")</td>
                                    <td class="text-end pe-3 text-nowrap">
                                        <div class="d-inline-flex gap-1 align-items-center">
                                            <a asp-controller="Reservas" asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-info text-white" title="Ver detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-controller="Pagos" asp-action="Index" asp-route-reservaId="@item.Id"
                                               class="btn btn-sm btn-outline-primary" title="Ver pagos">
                                                <i class="bi bi-cash-stack"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}
else
{
    <!-- Tab: Reservas Vigentes -->
    @if (!Model.ReservasVigentes.Any())
    {
        <div class="alert alert-info d-flex align-items-center mb-4" role="alert">
            <i class="bi bi-info-circle-fill flex-shrink-0 me-2 fs-5"></i>
            <div>No se registran reservas vigentes en este momento.</div>
        </div>
    }
    else
    {
        <div class="alert alert-success-subtle border border-success-subtle text-dark d-flex align-items-center mb-3 py-2">
            <i class="bi bi-check-circle-fill text-success me-2 fs-5"></i>
            <div>
                Se registran <strong>@Model.ReservasVigentes.Count</strong> reserva(s) actualmente en curso.
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 60px;"># ID</th>
                                <th>Inmueble</th>
                                <th>Inquilino</th>
                                <th class="text-nowrap">Desde</th>
                                <th class="text-nowrap">Hasta</th>
                                <th class="text-center">Días Restantes</th>
                                <th class="text-end">Monto Total</th>
                                <th class="text-end pe-3">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ReservasVigentes)
                            {
                                var fechaFin = item.FechaFinAnticipado ?? item.FechaHasta;
                                var diasRestantes = fechaFin.DayNumber - hoy.DayNumber;
                                string badgeClass;
                                string textoRestante;

                                if (diasRestantes <= 0)
                                {
                                    badgeClass = "bg-danger text-white";
                                    textoRestante = "Finaliza hoy";
                                }
                                else if (diasRestantes == 1)
                                {
                                    badgeClass = "bg-danger text-white";
                                    textoRestante = "1 día";
                                }
                                else if (diasRestantes <= 3)
                                {
                                    badgeClass = "bg-danger text-white";
                                    textoRestante = $"{diasRestantes} días";
                                }
                                else if (diasRestantes <= 7)
                                {
                                    badgeClass = "bg-warning text-dark";
                                    textoRestante = $"{diasRestantes} días";
                                }
                                else if (diasRestantes <= 15)
                                {
                                    badgeClass = "bg-info text-dark";
                                    textoRestante = $"{diasRestantes} días";
                                }
                                else
                                {
                                    badgeClass = "bg-primary-subtle text-primary border border-primary-subtle";
                                    textoRestante = $"{diasRestantes} días";
                                }

                                <tr>
                                    <td class="fw-semibold">@item.Id</td>
                                    <td>
                                        <div class="fw-semibold">@(item.Inmueble?.Direccion ?? "-")</div>
                                        <div class="small text-muted">
                                            <span class="badge bg-secondary-subtle text-secondary border">@(item.Inmueble?.Tipo?.Descripcion ?? "-")</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div>@(item.Inquilino?.NombreCompleto ?? "-")</div>
                                        <div class="small text-muted">DNI: @(item.Inquilino?.Dni ?? "-")</div>
                                    </td>
                                    <td class="text-nowrap">@item.FechaDesde.ToString("dd/MM/yyyy")</td>
                                    <td class="text-nowrap">@fechaFin.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center">
                                        <span class="badge @badgeClass">@textoRestante</span>
                                    </td>
                                    <td class="text-end fw-semibold text-nowrap">@item.MontoTotal.ToString("C")</td>
                                    <td class="text-end pe-3 text-nowrap">
                                        <div class="d-inline-flex gap-1 align-items-center">
                                            <a asp-controller="Reservas" asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-info text-white" title="Ver detalles">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a asp-controller="Pagos" asp-action="Index" asp-route-reservaId="@item.Id"
                                               class="btn btn-sm btn-outline-primary" title="Ver pagos">
                                                <i class="bi bi-cash-stack"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}
