@model inmobiliaria_lab2.Models.PaginacionViewModel

@{
    var controlador = !string.IsNullOrEmpty(Model?.Controlador) 
        ? Model.Controlador 
        : ViewContext.RouteData.Values["controller"]?.ToString();
}

@if (Model != null && Model.TotalPaginas > 1)
{
    <div class="card-footer d-flex justify-content-between align-items-center">
        <small class="text-muted">Página @Model.PaginaActual de @Model.TotalPaginas (@Model.TotalRegistros registros en total)</small>
        <nav aria-label="Navegación de páginas">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.PaginaActual <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="@Model.Accion" asp-controller="@controlador" asp-all-route-data="Model.ObtenerRuta(Model.PaginaActual - 1)">Anterior</a>
                </li>
                @for (int i = 1; i <= Model.TotalPaginas; i++)
                {
                    <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                        <a class="page-link" asp-action="@Model.Accion" asp-controller="@controlador" asp-all-route-data="Model.ObtenerRuta(i)">@i</a>
                    </li>
                }
                <li class="page-item @(Model.PaginaActual >= Model.TotalPaginas ? "disabled" : "")">
                    <a class="page-link" asp-action="@Model.Accion" asp-controller="@controlador" asp-all-route-data="Model.ObtenerRuta(Model.PaginaActual + 1)">Siguiente</a>
                </li>
            </ul>
        </nav>
    </div>
}
