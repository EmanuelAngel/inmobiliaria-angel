@model IEnumerable<inmobiliaria_lab2.Models.Reserva>

@{
    ViewData["Title"] = "Listado de Reservas";
    string? estadoFiltro = ViewBag.EstadoFiltro;
    int? idResaltado = ViewBag.Id != null ? Convert.ToInt32(ViewBag.Id) : null;
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2>@ViewData["Title"]</h2>
    <div class="d-flex gap-2">
        <form method="get" asp-action="Index" class="d-flex align-items-center gap-2">
            <label for="estado" class="form-label mb-0 text-nowrap fw-semibold">Estado:</label>
            <select id="estado" name="estado" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="" selected="@(string.IsNullOrEmpty(estadoFiltro))">Todos</option>
                <option value="Activa" selected="@(estadoFiltro == "Activa")">Activas</option>
                <option value="Finalizada" selected="@(estadoFiltro == "Finalizada")">Finalizadas</option>
                <option value="Cancelada" selected="@(estadoFiltro == "Cancelada")">Canceladas</option>
            </select>
        </form>
        <a asp-action="Create" class="btn btn-primary text-nowrap">
            <i class="bi bi-plus-circle"></i> Nueva Reserva
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Id)</th>
                        <th>Inmueble</th>
                        <th>Inquilino</th>
                        <th>@Html.DisplayNameFor(model => model.FechaDesde)</th>
                        <th>@Html.DisplayNameFor(model => model.FechaHasta)</th>
                        <th class="text-center">Días</th>
                        <th class="text-end text-nowrap">@Html.DisplayNameFor(model => model.MontoPorDia)</th>
                        <th class="text-center">@Html.DisplayNameFor(model => model.Estado)</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="@(idResaltado.HasValue && idResaltado.Value == item.Id ? "table-warning fw-semibold" : "")">
                                <td>@item.Id</td>
                                <td>@(item.Inmueble?.Direccion ?? "-")</td>
                                <td>@(item.Inquilino?.NombreCompleto ?? "-")</td>
                                <td class="text-nowrap">@item.FechaDesde.ToString("dd/MM/yyyy")</td>
                                <td class="text-nowrap">@item.FechaHasta.ToString("dd/MM/yyyy")</td>
                                <td class="text-center">
                                    <span class="badge bg-body-tertiary text-body border">@item.DiasTotal d</span>
                                </td>
                                <td class="text-end fw-semibold text-nowrap">@item.MontoPorDia.ToString("C")</td>
                                <td class="text-center">
                                    @switch (item.Estado)
                                    {
                                        case inmobiliaria_lab2.Models.EstadoReserva.Activa:
                                            <span class="badge bg-success">Activa</span>
                                            break;
                                        case inmobiliaria_lab2.Models.EstadoReserva.Finalizada:
                                            <span class="badge bg-secondary">Finalizada</span>
                                            break;
                                        case inmobiliaria_lab2.Models.EstadoReserva.Cancelada:
                                            <span class="badge bg-danger">Cancelada</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <div class="d-inline-flex gap-1 align-items-center">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-info text-white"
                                           data-bs-toggle="tooltip" data-bs-title="Ver detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (item.Estado == inmobiliaria_lab2.Models.EstadoReserva.Activa)
                                        {
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-warning"
                                               data-bs-toggle="tooltip" data-bs-title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-danger"
                                               data-bs-toggle="tooltip" data-bs-title="Cancelar reserva">
                                                <i class="bi bi-x-circle"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                No se encontraron reservas@(string.IsNullOrEmpty(estadoFiltro) ? "." : $" con estado '{estadoFiltro}'.")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <partial name="_Paginador" model="ViewBag.Paginacion as PaginacionViewModel" />
</div>
