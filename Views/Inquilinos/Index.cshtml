@model IEnumerable<inmobiliaria_lab2.Models.Inquilino>

@{
    ViewData["Title"] = "Listado de Inquilinos";
    int paginaActual = ViewBag.Pagina != null ? (int)ViewBag.Pagina : 1;
    int totalPaginas = ViewBag.TotalPaginas != null ? (int)ViewBag.TotalPaginas : 1;
    int tamDePagina = ViewBag.TamDePagina != null ? (int)ViewBag.TamDePagina : 10;
    int? idResaltado = ViewBag.Id != null ? Convert.ToInt32(ViewBag.Id) : null;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>@ViewData["Title"]</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Nuevo Inquilino
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>@Html.DisplayNameFor(model => model.Id)</th>
                        <th>@Html.DisplayNameFor(model => model.Dni)</th>
                        <th>@Html.DisplayNameFor(model => model.NombreCompleto)</th>
                        <th>@Html.DisplayNameFor(model => model.Email)</th>
                        <th>@Html.DisplayNameFor(model => model.Telefono)</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="@(idResaltado.HasValue && idResaltado.Value == item.Id ? "table-warning fw-semibold" : "")">
                                <td>@item.Id</td>
                                <td>@item.Dni</td>
                                <td>@item.NombreCompleto</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Email) ? "-" : item.Email)</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Telefono) ? "-" : item.Telefono)</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1" title="Detalles">Detalles</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1" title="Editar">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Eliminar">Eliminar</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                No se encontraron inquilinos registrados.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (totalPaginas > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <small class="text-muted">Página @paginaActual de @totalPaginas (@(ViewBag.TotalRegistros ?? 0) registros en total)</small>
            <nav aria-label="Navegación de páginas">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual - 1)" asp-route-tamDePagina="@tamDePagina">Anterior</a>
                    </li>
                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        <li class="page-item @(i == paginaActual ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-pagina="@i" asp-route-tamDePagina="@tamDePagina">@i</a>
                        </li>
                    }
                    <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-pagina="@(paginaActual + 1)" asp-route-tamDePagina="@tamDePagina">Siguiente</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
