@model inmobiliaria_lab2.Models.Propietario

@{
    ViewData["Title"] = "Detalle del Propietario";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h4 class="mb-0">@ViewData["Title"]</h4>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Id)</dt>
                    <dd class="col-sm-8">@Model.Id</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nombre)</dt>
                    <dd class="col-sm-8">@Model.Nombre</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Apellido)</dt>
                    <dd class="col-sm-8">@Model.Apellido</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Dni)</dt>
                    <dd class="col-sm-8">@Model.Dni</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Email)</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Telefono)</dt>
                    <dd class="col-sm-8">@Model.Telefono</dd>
                </dl>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-action="Index" class="btn btn-secondary">Volver al listado</a>
                <div>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Editar</a>
                    @if (User.IsInRole("Administrador"))
                    {
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">Eliminar</a>
                    }
                </div>
            </div>
        </div>

        @{
            var inmuebles = ViewBag.Inmuebles as IList<inmobiliaria_lab2.Models.Inmueble> ?? new List<inmobiliaria_lab2.Models.Inmueble>();
        }

        <div class="card shadow-sm mt-4">
            <div class="card-header bg-body-tertiary d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h5 class="mb-0">
                    <i class="bi bi-building me-1"></i> Inmuebles del Propietario (@inmuebles.Count)
                </h5>
                @if (inmuebles.Any())
                {
                    <a asp-controller="Inmuebles" asp-action="Index" asp-route-propietarioId="@Model.Id" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-list-ul me-1"></i> Ver en listado de inmuebles
                    </a>
                }
            </div>
            <div class="card-body p-0">
                @if (inmuebles.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0 align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 44px;">Foto</th>
                                    <th>Dirección</th>
                                    <th>Tipo</th>
                                    <th class="text-center">Cupo</th>
                                    <th class="text-end">Precio/Día</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var inm in inmuebles)
                                {
                                    <tr>
                                        <td class="text-center p-1">
                                            @if (!string.IsNullOrEmpty(inm.ImagenPortada))
                                            {
                                                <img src="@inm.ImagenPortada" alt="Foto @inm.Direccion" class="rounded object-fit-cover shadow-sm" style="width: 38px; height: 38px;" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'rounded bg-body-secondary d-flex align-items-center justify-content-center mx-auto\' style=\'width:38px;height:38px;\'><i class=\'bi bi-image text-muted\'></i></div>';" />
                                            }
                                            else
                                            {
                                                <div class="rounded bg-body-secondary d-flex align-items-center justify-content-center mx-auto" style="width: 38px; height: 38px;">
                                                    <i class="bi bi-image text-muted"></i>
                                                </div>
                                            }
                                        </td>
                                        <td class="fw-semibold">@inm.Direccion</td>
                                        <td>@(inm.Tipo?.Descripcion ?? "-")</td>
                                        <td class="text-center">@inm.Cupo pers.</td>
                                        <td class="text-end">@inm.PrecioPorDia.ToString("C")</td>
                                        <td class="text-center">
                                            @if (inm.Estado == inmobiliaria_lab2.Models.EstadoInmueble.Disponible)
                                            {
                                                <span class="badge bg-success">Disponible</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark">Suspendido</span>
                                            }
                                        </td>
                                        <td class="text-end text-nowrap">
                                            <a asp-controller="Inmuebles" asp-action="Details" asp-route-id="@inm.Id"
                                               class="btn btn-sm btn-info text-white" data-bs-toggle="tooltip" data-bs-title="Ver detalles del inmueble">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted">
                        <i class="bi bi-building-slash fs-3 d-block mb-2 text-secondary"></i>
                        Este propietario aún no tiene inmuebles registrados en el sistema.
                    </div>
                }
            </div>
        </div>
    </div>
</div>
